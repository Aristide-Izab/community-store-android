<?xml version="1.0" encoding="utf-8"?>
<!-- Box background with a dropdown arrow, for Spinners that replace the default background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_spinner_box" />
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_arrow_down"
        android:gravity="end|center_vertical"
        android:right="12dp" />
</layer-list>
