<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/conversationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="21dp"
        android:paddingTop="12dp"
        android:paddingEnd="19dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="39dp"
            android:layout_height="33dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_avatar_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/conversationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Campus Eats"
                android:textColor="@color/residence_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/conversationPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:text="Hi, your order is ready for pickup."
                android:textColor="@color/residence_text"
                android:textSize="16sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/conversationUnread"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_residence_count_badge"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/conversationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="Mon"
                android:textColor="@color/residence_text"
                android:textSize="13sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <View
        style="@style/ResidenceDivider"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp" />

</LinearLayout>
