<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/residence_purple"
    android:orientation="vertical">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:paddingStart="21dp"
        android:paddingEnd="27dp">

        <TextView
            android:id="@+id/greetingText"
            style="@style/ResidenceHeaderTitle"
            android:layout_width="0dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Good morning , Resident"
            app:layout_constraintEnd_toStartOf="@id/avatarButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/roleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:text="Residence"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/greetingText" />

        <ImageView
            android:id="@+id/verifiedIcon"
            android:layout_width="19.5dp"
            android:layout_height="19.5dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_residence_verified_badge"
            app:layout_constraintBottom_toBottomOf="@id/roleText"
            app:layout_constraintStart_toEndOf="@id/roleText"
            app:layout_constraintTop_toTopOf="@id/roleText" />

        <TextView
            android:id="@+id/verifiedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Verified"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintBaseline_toBaselineOf="@id/roleText"
            app:layout_constraintStart_toEndOf="@id/verifiedIcon" />

        <FrameLayout
            android:id="@+id/avatarButton"
            android:layout_width="39dp"
            android:layout_height="33dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ic_avatar_background"
            android:clickable="true"
            android:contentDescription="Open profile"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_avatar_person" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sheet -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_residence_sheet"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Loyalty points card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/loyaltyCard"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="19dp"
                android:background="@drawable/bg_residence_card_tint"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/loyaltyDiamond"
                    android:layout_width="54dp"
                    android:layout_height="53dp"
                    android:layout_marginStart="31dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_diamond"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/loyaltyPointsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="1,240"
                    android:textColor="#647488"
                    android:textSize="22sp"
                    app:layout_constraintStart_toEndOf="@id/loyaltyDiamond"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/loyaltyCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Loyalty Points\n100 pnts/month"
                    android:textColor="@color/residence_slate"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/loyaltyDiamond"
                    app:layout_constraintTop_toBottomOf="@id/loyaltyPointsText" />

                <TextView
                    android:id="@+id/viewRewardsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="21dp"
                    android:layout_marginBottom="10dp"
                    android:text="View Rewards"
                    android:textColor="@color/residence_text_muted"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginStart="23dp"
                android:layout_marginTop="23dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_residence_card_tint"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Sales"
                        android:textColor="@color/residence_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/totalSalesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="R24,750"
                        android:textColor="@color/residence_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_residence_card_tint"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orders"
                        android:textColor="@color/residence_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/ordersCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="134"
                        android:textColor="@color/residence_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/productsCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_residence_card_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Products"
                        android:textColor="@color/residence_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/productsCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/residence_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Recent orders -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="29dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Recent Orders"
                    android:textColor="@color/residence_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/moreOrdersText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:padding="4dp"
                    android:text="More"
                    android:textColor="@color/residence_text"
                    android:textSize="14sp" />

            </LinearLayout>

            <View
                style="@style/ResidenceDivider"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="19dp" />

            <LinearLayout
                android:id="@+id/recentOrdersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
