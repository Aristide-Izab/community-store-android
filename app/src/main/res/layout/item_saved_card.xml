<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_checkout_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/savedCardBrandImage"
        android:layout_width="48dp"
        android:layout_height="34dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mastercard" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/savedCardBrandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mastercard"
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/savedCardLastFourText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="•••• 0864"
            android:textColor="#555555"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/savedCardRadio"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="○"
        android:textColor="#A5ABB3"
        android:textSize="25sp" />

    <ImageView
        android:id="@+id/savedCardDeleteButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Remove saved card"
        android:padding="4dp"
        android:src="@drawable/ic_delete_outline"
        android:visibility="gone"
        app:tint="#D32F2F" />

</LinearLayout>
