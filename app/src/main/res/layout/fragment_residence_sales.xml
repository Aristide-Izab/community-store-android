<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/residence_purple"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            style="@style/ResidenceBackButton" />

        <TextView
            style="@style/ResidenceHeaderTitle"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="Income/Revenue" />

    </LinearLayout>

    <!-- Sheet -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_residence_sheet"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Period filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="43dp"
                android:layout_marginEnd="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/periodWeek"
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_residence_button"
                    android:gravity="center"
                    android:text="This week"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/periodMonth"
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_residence_button"
                    android:gravity="center"
                    android:text="This Month"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/periodYear"
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_residence_button"
                    android:gravity="center"
                    android:text="This Year"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Total income -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginStart="27dp"
                android:layout_marginTop="39dp"
                android:layout_marginEnd="35dp"
                android:background="@drawable/bg_residence_input">

                <TextView
                    android:id="@+id/totalIncomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Total Income"
                    android:textColor="@color/residence_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/totalIncomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="R24,750"
                    android:textColor="@color/residence_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/totalIncomeLabel" />

                <ImageView
                    android:id="@+id/incomeTrendIcon"
                    android:layout_width="21dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="164dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trend_up"
                    app:layout_constraintBottom_toBottomOf="@id/totalIncomeText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/totalIncomeText" />

                <TextView
                    android:id="@+id/incomeTrendText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="18%"
                    android:textColor="@color/residence_trend_green"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/incomeTrendIcon"
                    app:layout_constraintStart_toEndOf="@id/incomeTrendIcon"
                    app:layout_constraintTop_toTopOf="@id/incomeTrendIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Orders + payout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="34dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_residence_input"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Orders"
                        android:textColor="@color/residence_text"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/totalOrdersText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="128"
                            android:textColor="@color/residence_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="33dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trend_up" />

                        <TextView
                            android:id="@+id/ordersTrendText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="12%"
                            android:textColor="@color/residence_trend_green"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="39dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_residence_input"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Payout"
                        android:textColor="@color/residence_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/pendingPayoutText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="R340"
                        android:textColor="@color/residence_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="39dp"
                android:fontFamily="sans-serif-medium"
                android:text="Recent Income"
                android:textColor="@color/residence_text"
                android:textSize="20sp" />

            <View
                style="@style/ResidenceDivider"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:id="@+id/recentIncomeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
