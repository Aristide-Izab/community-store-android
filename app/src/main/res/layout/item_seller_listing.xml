<?xml version="1.0" encoding="utf-8"?>
<!-- One listing row on the Seller Profile screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/listingCard"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_seller_product_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="98dp"
                        android:background="#F3F3F3"
                        android:padding="4dp"
                        android:scaleType="centerInside"
                        android:id="@+id/listingImage"
                        android:src="@drawable/ic_product_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/listingTitle"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Listing"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:id="@+id/listingPrice"
                            android:text="R8,499"
                            android:textColor="@color/role_faculty"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_rating_star" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:id="@+id/listingMeta"
                                android:text="Used • Electronics"
                                android:textColor="#555555"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/listingFavourite"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_favourite_button"
                        android:contentDescription="Favourite"
                        android:padding="6dp"
                        android:src="@drawable/ic_favourite"
                        app:tint="#555555" />

                </LinearLayout>
