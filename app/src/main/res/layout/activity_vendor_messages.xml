<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFA726"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
        <TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="36sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Messages" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                <TextView android:id="@+id/chatsTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Chats" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/requestsTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Requests" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/chatsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#F8FAFC" android:padding="16dp" android:text="Campus Eats\nHi, your order is ready for pickup                                      2" android:textColor="#111111" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Smith\nNew items available                                                      1" android:textColor="#111111" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Aristide\nYes, it is available                                                   Mon" android:textColor="#111111" />
            </LinearLayout>

            <LinearLayout android:id="@+id/requestsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="50dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No new message requests." android:textColor="#64748B" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
