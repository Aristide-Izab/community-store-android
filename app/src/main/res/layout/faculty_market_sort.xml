<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sheetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sort By"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sortReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="Reset"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/sortGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp">

        <RadioButton
            android:id="@+id/sortRelevant"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Most Relevant"
            android:textColor="#111111"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sortPriceLow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Price: Low to High"
            android:textColor="#111111"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sortPriceHigh"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Price: High to Low"
            android:textColor="#111111"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sortNewest"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Newest First"
            android:textColor="#111111"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sortPopular"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Most Popular"
            android:textColor="#111111"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/applySort"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_margin="18dp"
        android:gravity="center"
        android:text="Apply"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
