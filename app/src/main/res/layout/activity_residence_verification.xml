<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#111111"
            android:textSize="40sp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/residenceIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="⬟"
            android:textColor="#4B00D1"
            android:textSize="72sp"
            app:layout_constraintTop_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/residenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Verify Residence"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/residenceIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/residenceDescription"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:text="Residence admin accounts are manually approved to prevent fake announcements."
            android:textColor="#444444"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/residenceTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/residenceNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="42dp"
            android:layout_marginTop="25dp"
            android:text="Residence / Campus House"
            android:textColor="#222222"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/residenceDescription"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/residenceNameInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginTop="7dp"
            android:hint="Belmont House"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            android:background="@drawable/edit_text_background"
            app:layout_constraintTop_toBottomOf="@id/residenceNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/wardenEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="42dp"
            android:layout_marginTop="18dp"
            android:text="Warden Email"
            android:textColor="#222222"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/residenceNameInput"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/wardenEmailInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginTop="7dp"
            android:hint="warden.belmont@cput.ac.za"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            android:background="@drawable/edit_text_background"
            app:layout_constraintTop_toBottomOf="@id/wardenEmailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/uploadButton"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginTop="20dp"
            android:text="📎\nUpload appointment letter\nPDF • Max 10MB"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp"
            android:backgroundTint="#E5D7FF"
            app:layout_constraintTop_toBottomOf="@id/wardenEmailInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="No PDF selected"
            android:textColor="#666666"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/uploadButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/reviewInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginTop="18dp"
            android:background="#E5D7FF"
            android:gravity="center"
            android:padding="12dp"
            android:text="A residence team member will confirm your role within 1–2 working days before posting rights are enabled."
            android:textColor="#555555"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/selectedFileText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="30dp"
            android:text="Submit for Approval"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#4B00D1"
            app:layout_constraintTop_toBottomOf="@id/reviewInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>