<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/residence_purple"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            style="@style/ResidenceBackButton" />

        <TextView
            style="@style/ResidenceHeaderTitle"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="Messages" />

    </LinearLayout>

    <!-- Sheet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_residence_sheet"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginStart="33dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="43dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_residence_toggle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Chats"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/requestsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="26dp"
                android:layout_weight="1"
                android:background="@drawable/bg_residence_toggle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Requests"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            style="@style/ResidenceDivider"
            android:layout_marginStart="15dp"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="19dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/messagesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No message requests."
                    android:textColor="@color/residence_slate"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/conversationsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
