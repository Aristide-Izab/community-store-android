<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_residence_outline_card">

    <View
        android:id="@+id/leaderboardThumb"
        android:layout_width="35dp"
        android:layout_height="38dp"
        android:layout_marginStart="21dp"
        android:background="@color/residence_slate_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/leaderboardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:text="Student Store"
        android:textColor="@color/residence_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/leaderboardTag"
        app:layout_constraintStart_toEndOf="@id/leaderboardThumb"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/leaderboardSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="sans-serif-light"
        android:text="Total Sales R15,000"
        android:textColor="@color/residence_text"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/leaderboardTitle"
        app:layout_constraintTop_toBottomOf="@id/leaderboardTitle" />

    <TextView
        android:id="@+id/leaderboardTag"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_residence_tag"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="Claimed"
        android:textColor="@color/residence_text"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
