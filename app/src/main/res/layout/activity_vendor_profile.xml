<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFA726"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
        <TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="36sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Profile" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="0dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="84dp" android:layout_height="84dp" app:cardBackgroundColor="#E5E7EB" app:cardCornerRadius="42dp" app:cardElevation="0dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:src="@drawable/ic_profile_outline" android:tint="#64748B" android:contentDescription="Profile" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/nameText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Vendor" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/emailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="vendor@example.com" android:textColor="#64748B" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Vendor  ✓ Verified" android:textColor="#64748B" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sales\n15" android:textColor="#111111" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Reviews\n5" android:textColor="#111111" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Rewards\n1000" android:textColor="#111111" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:id="@+id/salesHubRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="#F8FAFC" android:clickable="true" android:focusable="true" android:padding="16dp" android:text="Sales &amp; Order Hub                                      ›" android:textColor="#111111" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Authentication                                            ›" android:textColor="#111111" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Payment Options                                          ›" android:textColor="#111111" />
                <TextView android:id="@+id/rewardsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:clickable="true" android:focusable="true" android:padding="16dp" android:text="Rewards &amp; Ratings                                       ›" android:textColor="#111111" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Settings                                                  ›" android:textColor="#111111" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#F8FAFC" android:padding="16dp" android:text="Vendor Support &amp; Guidelines                             ›" android:textColor="#111111" />

                <Button android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:backgroundTint="#FFA726" android:text="Log Out" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" app:cornerRadius="27dp" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
