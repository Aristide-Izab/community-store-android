<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommunityStore">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.WelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ChooseAccountTypeActivity"
            android:exported="false" />

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ResetPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".auth.AccountVerifiedActivity"
            android:exported="false" />

        <activity
            android:name=".auth.LogoutActivity"
            android:exported="false" />

        <activity
            android:name=".auth.VendorVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ResidenceVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".auth.VerifyStudentActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter android:autoVerify="true">

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="community-store-de45f.firebaseapp.com"
                    android:pathPrefix="/__/auth/links" />

            </intent-filter>

        </activity>

        <activity
            android:name=".auth.SplashActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>